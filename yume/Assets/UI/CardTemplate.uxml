                <ui:VisualElement name="CardSprite" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Art/UniversalIconBronze/Textures/Icons/Ring_01.png?fileID=2800000&amp;guid=fc4789f021f02264385fab7ff3625027&amp;type=3#Ring_01&quot;); -unity-background-scale-mode: scale-to-fit; position: absolute; height: 216px; width: 190px; top: 0; left: 13px;" />
