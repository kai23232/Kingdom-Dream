                    <ui:Label tabindex="-1" text="攻击" parse-escape-sequences="true" display-tooltip-when-elided="true" name="CardName" style="-unity-text-align: middle-center; height: 39px; -unity-font-style: bold-and-italic; font-size: 17px; color: rgb(255, 255, 255);" />
                </ui:VisualElement>
                <ui:VisualElement style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Art/Card/card_type.png?fileID=2800000&amp;guid=de73d6551715d4ad3abfe23b5591c365&amp;type=3#card_type&quot;); -unity-background-scale-mode: scale-to-fit; position: absolute; height: 57px; width: 132px; top: 160px; left: 43px;">
